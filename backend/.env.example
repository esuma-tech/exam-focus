# ---- EXAM FOCUS backend configuration ----
# Copy this file to .env and adjust for your environment.

ENVIRONMENT=development

# --- Database ---
# Local zero-config default (SQLite):
DATABASE_URL=sqlite:///./examfocusedu.db
# Production PostgreSQL — use a free hosted Postgres (Neon: console.neon.tech).
# Create a database, then use the connection string, e.g.:
# postgresql+psycopg://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/examfocus?sslmode=require
# DATABASE_URL=postgresql+psycopg://...@.../examfocus?sslmode=require

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- URLs / uploads ---
PUBLIC_BASE_URL=http://localhost:8000
UPLOAD_DIR=uploads

# --- CORS (list is parsed as a JSON array) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# In production add your deployed frontend URL, e.g.:
# CORS_ORIGINS=["https://exam-focus.vercel.app"]

# --- Email notifications (leave SMTP_HOST empty to log instead of send) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@examfocus.edu.et
SMTP_TLS=true

# --- SMS notifications (console = log only; swap for a real provider) ---
SMS_PROVIDER=console
SMS_API_KEY=

# --- Live classroom ---
LIVE_PROVIDER=jitsi
LIVE_JITSI_DOMAIN=meet.jit.si
